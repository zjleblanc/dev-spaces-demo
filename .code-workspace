{
	"settings": {
		"ansible.lightspeed.suggestions.enabled": true,
		"ansible.lightspeed.enabled": true,
		"ansible.ansible.useFullyQualifiedCollectionNames": true,
		"ansible.validation.enabled": true,
		"ansible.validation.lint.enabled": true,
		"ansible.validation.lint.arguments": "--profile production --offline",
		"ansible.executionEnvironment.enabled": true,
		"ansible.executionEnvironment.containerEngine": "podman",
		"ansible.executionEnvironment.image": "quay.io/zleblanc/ee-default:ac1abd92",
		"ansible.executionEnvironment.pull.policy": "missing",
		"files.trimTrailingWhitespace": true,
		"files.trimFinalNewlines": true,
		"files.insertFinalNewline": true,
		"openshiftToolkit.showWelcomePage": false,
		"editor.wordWrap": "on",
		"files.autoSave": "afterDelay",
		"python.defaultInterpreterPath": "/usr/bin/python3",
		"python.useEnvironmentsExtension": false
	},
	"folders": [
		{
			"name": "dev-spaces-demo",
			"path": "/projects/dev-spaces-demo"
		}
	],
	"extensions": {
		"recommendations": [
			"redhat.ansible",
			"redhat.vscode-yaml",
			"redhat.vscode-openshift-connector",
			"ms-python.python"
		]
	}
}
